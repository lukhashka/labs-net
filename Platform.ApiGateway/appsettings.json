{
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {"ClusterId": "aggregator", "Order": 1, "Match": {"Path": "/api/aggregator/{**catch-all}"}, "AuthorizationPolicy": "default"},
      "orders": {"ClusterId": "orders", "Match": {"Path": "/api/orders/{**catch-all}"}, "MaxRequestBodySize": 1048576, "Metadata": {"Team": "orders", "Version": "v1"}, "AuthorizationPolicy": "default"},
      "customers": {"ClusterId": "orders", "Match": {"Path": "/api/customers/{**catch-all}"}, "AuthorizationPolicy": "default"},
      "tickets": {"ClusterId": "orders", "Match": {"Path": "/api/tickets/{**catch-all}"}, "AuthorizationPolicy": "default"},
      "events": {"ClusterId": "catalog", "Match": {"Path": "/api/events/{**catch-all}"}, "AuthorizationPolicy": "default"},
      "ticket-types": {"ClusterId": "catalog", "Match": {"Path": "/api/ticket-types/{**catch-all}"}, "AuthorizationPolicy": "default"},
      "categories": {"ClusterId": "catalog", "Match": {"Path": "/api/categories/{**catch-all}"}, "AuthorizationPolicy": "default"},
      "venues": {"ClusterId": "catalog", "Match": {"Path": "/api/venues/{**catch-all}"}, "AuthorizationPolicy": "default"},
      "reviews": {"ClusterId": "reviews", "Match": {"Path": "/api/reviews/{**catch-all}"}, "AuthorizationPolicy": "default"},
      "discussions": {"ClusterId": "reviews", "Match": {"Path": "/api/discussions/{**catch-all}"}, "AuthorizationPolicy": "default"},
      "auth": {"ClusterId": "auth", "Order": 1, "Match": {"Path": "/auth/{**catch-all}"}, "AuthorizationPolicy": "anonymous"},
      "users": {"ClusterId": "auth", "Order": 1, "Match": {"Path": "/users/{**catch-all}"}, "AuthorizationPolicy": "default"},
      "payments": {"ClusterId": "payments", "Match": {"Path": "/api/payments/{**catch-all}"}, "AuthorizationPolicy": "default"}
    },
    "Clusters": {
      "aggregator": {"HttpRequest": {"ActivityTimeout": "00:00:30"}, "Destinations": {"d1": {"Address": "http://aggregator"}}},
      "orders": {"HttpRequest": {"ActivityTimeout": "00:00:30"}, "Destinations": {"d1": {"Address": "http://orders-api"}}},
      "catalog": {"LoadBalancingPolicy": "RoundRobin", "HttpRequest": {"ActivityTimeout": "00:00:30"}, "Destinations": {"d1": {"Address": "http://catalog-api"}}},
      "reviews": {"HttpRequest": {"ActivityTimeout": "00:00:30"}, "Destinations": {"d1": {"Address": "http://reviews-api"}}},
      "auth": {"HttpRequest": {"ActivityTimeout": "00:00:30"}, "Destinations": {"d1": {"Address": "http://auth-api"}}},
      "payments": {"HttpRequest": {"ActivityTimeout": "00:00:30"}, "Destinations": {"d1": {"Address": "http://payments-api"}}}
    }
  }
}
