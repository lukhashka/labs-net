{
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": { "ClusterId": "aggregator", "Order": 1, "Match": { "Path": "/api/aggregator/{**catch-all}" } },
      "orders": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "MaxRequestBodySize": 1048576,
        "Metadata": { "Team": "orders", "Version": "v1" }
      },
      "customers": { "ClusterId": "orders", "Match": { "Path": "/api/customers/{**catch-all}" } },
      "tickets": { "ClusterId": "orders", "Match": { "Path": "/api/tickets/{**catch-all}" } },
      "events": { "ClusterId": "catalog", "Match": { "Path": "/api/events/{**catch-all}" } },
      "ticket-types": { "ClusterId": "catalog", "Match": { "Path": "/api/ticket-types/{**catch-all}" } },
      "categories": { "ClusterId": "catalog", "Match": { "Path": "/api/categories/{**catch-all}" } },
      "venues": { "ClusterId": "catalog", "Match": { "Path": "/api/venues/{**catch-all}" } },
      "reviews": { "ClusterId": "reviews", "Match": { "Path": "/api/reviews/{**catch-all}" } },
      "discussions": { "ClusterId": "reviews", "Match": { "Path": "/api/discussions/{**catch-all}" } }
    },
    "Clusters": {
      "aggregator": { "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "d1": { "Address": "http://aggregator" } } },
      "orders": { "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "d1": { "Address": "http://orders-api" } } },
      "catalog": { "LoadBalancingPolicy": "RoundRobin", "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "d1": { "Address": "http://catalog-api" } } },
      "reviews": { "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "d1": { "Address": "http://reviews-api" } } }
    }
  }
}
